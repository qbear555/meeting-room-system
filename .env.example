# 伺服器埠號
PORT=3849

# 前端服務埠號 (開發模式)
FRONTEND_PORT=5173

# 資料庫類型：'sqlite' (預設，零配置檔案型資料庫) 或 'mysql'
DB_TYPE=sqlite
DB_PATH=./data/meeting_room.db

# MySQL 連線設定 (若 DB_TYPE=mysql 時啟用)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=meeting_rooms

# JWT 密鑰
JWT_SECRET=meeting_room_secret_key_change_in_production

# SMTP 郵件發信通知設定 (選填，填入後預約時將自動發送會議通知信至與會同仁信箱)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_email_password_or_app_token
# SMTP_FROM="會議預約系統 <no-reply@domain.com>"
# BASE_URL=http://localhost:3849
